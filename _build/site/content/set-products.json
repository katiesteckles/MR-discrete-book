em;\"></span><span class=\"mord\">2</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\">…</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">n</span><span class=\"mclose\">}</span></span></span></span></span>","key":"muYKz6MYQr"}],"label":"cartesian-product-definition","identifier":"cartesian-product-definition","html_id":"cartesian-product-definition","key":"S6iBudyYnc"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Example:\ni. If A = {0,1,2} and B = {2,3} are two sets then the Cartesian product of A and B is\ngiven as: A \\times B = {(0,2), (0,3), (1,2), (1,3), (2,2), (2,3)}.\nii. iii. If A = {1,2} and B = {p, q, 𝑟}, then the Cartesian product of A and B is given as\nA \\times B = {(1, p), (1, q), (1, 𝑟), (2, p), (2, q), (2, 𝑟)}.\nIf A = {1,2}, B = {m, n} and 𝐶 = {p, q}, then the Cartesian product of A, B and C\nis given as: A \\times B \\times 𝐶 =\n{(1, m, p), (1, m, q), (1, n, p), (1, n, q), (2, m, p), (2, m, q), (2, n, p), (2, n, q)}.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"M6UwC8RhY2"}],"key":"J5HqVuO2Wa"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"An important example of a Cartesian product is given by the set of all Cartesian\ncoordinates in a plane. This product is given as 𝑅 \\times 𝑅, or 𝑅2","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"bGsLPaThO3"}],"key":"g2Xe8x8NBo"},{"type":"heading","depth":2,"position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Representation of Cartesian Products","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"eXxLFfgvsX"}],"identifier":"representation-of-cartesian-products","label":"Representation of Cartesian Products","html_id":"representation-of-cartesian-products","implicit":true,"enumerator":"1.8.1","key":"OMUpetAV0u"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"• The Graphical Representation\nY\nx\n• Table Representation\nFor the tabular representation of the cross product of two sets A and B, we need to\ndraw a table or a ‘rectangular array’ in which the row number represents the elements\nof A and column number represents the elements of B, as shown in the following\nexample.\nExample:\nLet A = {a, b}and B = {w, x, y, z}. Using the tabular representation find the cross\nproducts:\ni. A \\times B\nw x y z\na (a, w) (a, x) (a, y) (a, z)\nb (b, w) (b, x) (b, y) (b, z)\n(i.e. A \\times B = {(a, w), (a, x), (a, y), (a, z), (b, w), (b, x), (b, y), (b, z)})\nii. B \\times A\na b\nw (w, a) (w, b)\nx (x, a) (x, b)\ny (y, a) (y, b)\nz (z, a) (z, b)\niii. iv. (i.e. B \\times A = {(w, a), (w, b), (x, a), (x, b), (y, w), (y, b), (z, a), (z, b)}).\nNote the differences between the elements of the cross products A \\times B and B \\times A.\nA \\times A (to be completed by students).\nB \\times B (to be completed by students).\n27\n• The Tree Diagram Representation\nThis is illustrated by the following examples.\nExample:\ni. Let A = {1,2}, B = {x, y, z} and 𝐶 = {3,4}. Find the Cartesian products of A, B\nand C using a tree representation.\n1 2\nx y z x y z\nii. 3 4 3 4 3 4 3 4 3 4 3 4\nTherefore, there are 12 ordered triplets of A \\times B \\times 𝐶, i.e.\nA \\times B \\times 𝐶 = {(1, x, 3), (1, x, 4), (1, y, 3), (1, y, 4), (1, z, 3), (1, z, 4),\n(2, x, 3), (2, x, 4), (2, y, 3), (2, y, 4), (2, z, 3), (2, z, 4)}.\nLet A = {1,2}, B = {x, y, z, p}, 𝐶 = {q} and 𝐷 = {3,1}.\nFind the Cartesian productA \\times B \\times 𝐶 \\times 𝐷, using a tree representation.\n1 2\nx y z p x y z p\nq q q q q q q q\n3 1 3 1 3 1 3 1 3 1 3 1 3 1 3 1\n28\nTherefore, there are 16 ordered quartets of A \\times B \\times 𝐶 \\times 𝐷, i.e.\n{(1, x, q, 3), (1, x, q, 1), (1, y, q, 3), (1, y, q, 1), (1, z, q, 3), (1, z, q, 1), (1, p, q, 3), (1, p, q, 1)\n(2, x, q, 3), (2, x, q, 1), (2, y, q, 3), (2, y, q, 1), (2, z, q, 3), (2, z, q, 1), (2, p, q, 3), (2, p, q, 1)}.\nThere are two things worth noting :","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"shV8Hmitjt"}],"key":"YWT9MfpGSw"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":93,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":93,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"A \\times B \\neq B \\times A.\nThe Cartesian product deals with ordered pairs, so naturally the order in which\nthe sets are considered is important.","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"OMhBbuLEtb"}],"key":"u2IjZUMLW5"}],"key":"Zy2S7WVNS8"},{"type":"listItem","spread":true,"position":{"start":{"line":96,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"n(A \\times B) = n(A). n(B).\nThe number of elements in the Cartesian products of sets can be found using\nthe corresponding set cardinalities,\ni.e. n(A) = 2, n(B) = 4, n(𝐶) = 1, n(𝐷) = 2, and\nn(A \\times B \\times 𝐶 \\times 𝐷) = 16.\nOther examples will be discussed in the lecture","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"M608Hn7UoN"}],"key":"PNaiIqVD6y"}],"key":"vqO4ioUWdJ"}],"key":"pF1N7Vesw9"}],"key":"RtILRW3HJI"}],"key":"QcOBY794KY"},"references":{"cite":{"order":[],"data":{}}}}